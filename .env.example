# Base URL of your Cloudflare R2 public bucket (or custom domain / CDN in front of it).
# Tiles are expected under this base, e.g.:
#   $R2/ortho/{z}/{x}/{y}.png        <- orthophoto raster pyramid (gdal2tiles)
#   $R2/dem/{z}/{x}/{y}.png          <- Terrain-RGB DEM tiles (rio-rgbify, encoding=mapbox)
#   $R2/vector/{layer}.geojson       <- vector layers (or swap for PMTiles/MVT)
NEXT_PUBLIC_R2_BASE_URL=https://pub-xxxxxxxx.r2.dev/webgis
